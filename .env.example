# Environment variables for LANDSIGHT
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/landsight

# ── Target District ───────────────────────────────
TARGET_DISTRICT=kohima          # e.g. kohima, aizawl, jorhat
TARGET_STATE=nagaland
BBOX_LAT_MIN=25.4
BBOX_LAT_MAX=26.2
BBOX_LON_MIN=93.8
BBOX_LON_MAX=94.6

# ── Data Sources ──────────────────────────────────
IMD_API_KEY=your_imd_api_key_here
BHUVAN_API_KEY=your_bhuvan_api_key_here
GPM_IMERG_URL=https://gpm.nasa.gov/data/imerg

# ── Model Settings ────────────────────────────────
RISK_MODEL_PATH=modules/M2_risk_model/saved_models/rf_model.joblib
RISK_THRESHOLD_HIGH=0.75
RISK_THRESHOLD_MEDIUM=0.45

# ── Confidence Thresholds ─────────────────────────
CONFIDENCE_THRESHOLD_HIGH=0.70
CONFIDENCE_THRESHOLD_LOW=0.40

# ── Live Pipeline (M9) ────────────────────────────
PIPELINE_RERUN_INTERVAL_HOURS=3
RAINFALL_WINDOW_HOURS=72

# ── API ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
